# Hours a cached search result stays valid
SEARCH_CACHE_TTL_HOURS=6

# Leave empty to use a dev fixture instead of calling SerpApi
# Obtain free key at https://serpapi.com
SERPAPI_KEY=

# Required for geocoding and routing via OpenRouteService
# Free key at https://openrouteservice.org
ORS_API_KEY=

# Required for Chat assistant. Leave blank to disable chat
# One of: anthropic, openai, ollama - then set that provider's key/URL below.
CHAT_PROVIDER=
# Leave blank to use app's set model.
CHAT_MODEL=
# Required if CHAT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required if CHAT_PROVIDER=openai.
OPENAI_API_KEY=
# Required if CHAT_PROVIDER=ollama. Must be a tool-calling model. e.g gemma4:e2b or larger model
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Seconds to wait for a provider response - raise significantly for CHAT_PROVIDER=ollama on CPU.
CHAT_TIMEOUT_SECONDS=60
