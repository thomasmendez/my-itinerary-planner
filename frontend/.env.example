# Client-visible. Master switch for MSW (the in-browser mock layer). "true" (default):
# every /api/* route below is mocked, no backend needed. "false": MSW is off entirely
# and everything proxies to the real backend (BACKEND_URL below) — VITE_MOCK_TRIPS is
# then irrelevant, since there's nothing left for it to un-mock.
VITE_MOCKING=true

# Client-visible. Only matters when VITE_MOCKING=true. "true" (default): MSW also mocks
# the trip-scoped routes (/api/trips, saved flights/hotels/rentals/events, calendar).
# "false": those specific routes proxy to the real backend instead, so you can test trip
# persistence without a SERPAPI_KEY — /api/search/* stays mocked either way.
VITE_MOCK_TRIPS=true

# Server-side only. Dev-server proxy target used whenever a route above is proxied
# instead of mocked.
BACKEND_URL=http://localhost:8000

# Client-visible. Only has an effect when VITE_MOCKING=false (mocked mode always
# allows past dates already). "true" allows past depart dates, to exercise the
# backend's dev fixture without a SERPAPI_KEY.
VITE_ALLOW_PAST_DEPART_DATE=false
